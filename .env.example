# Sao chép file này thành `.env` rồi điền giá trị thật.
# Vite chỉ expose các biến có tiền tố VITE_ ra client (import.meta.env.VITE_*).

# Bắt buộc: URL backend. Cũng dùng luôn cho WebSocket (`${VITE_API_URL}/ws`).
VITE_API_URL=http://localhost:8080

VITE_GEMINI_API_KEY=

# Không bắt buộc: dùng làm returnUrl/cancelUrl khi thanh toán.
# Bỏ trống thì tự lấy origin của trang đang chạy, nên trên Vercel không cần set.
VITE_CLIENT_URL=
